{
  "manifest_version": 3,
  "default_locale": "de",
  "name": "__MSG_ext_name__",
  "short_name": "SMarTrChrome",
  "version": "0.6.1",
  "description": "__MSG_ext_beschreibung__",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.smartragents.ai/*",
    "https://connect.smartragents.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://cloud.smartragents.ai/*"
    ]
  },
  "background": {
    "service_worker": "src/background/worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_ext_symbol_titel__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "notbremse": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_ext_notbremse__"
    }
  }
}