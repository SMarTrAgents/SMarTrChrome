{
  "manifest_version": 3,
  "name": "SMarTrChrome Beta",
  "short_name": "SMarTrChrome",
  "version": "0.5.0",
  "description": "SMarTrAgents im Browser. Der Agent liest, zeigt, klickt, tippt und waehlt aus — jeden Schritt gibst du einzeln frei. Passwoerter tippt er nie.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://api.smartragents.ai/*",
    "https://connect.smartragents.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://cloud.smartragents.ai/*"
    ]
  },
  "background": {
    "service_worker": "src/background/worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "SMarTrChrome — Niemand öffnen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "notbremse": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Notbremse — Agentensitzung sofort beenden"
    }
  }
}